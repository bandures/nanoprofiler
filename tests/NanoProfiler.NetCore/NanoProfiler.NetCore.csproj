<Project>

    <PropertyGroup>
        <!--
        Changing NuGet restore output path. This needs to be set before Sdk.props.
        https://stackoverflow.com/a/45589468
        -->
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts~\obj\$(Configuration)</BaseIntermediateOutputPath>
    </PropertyGroup>
	
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

    <PropertyGroup>
        <PackageId>NanoProfiler.NetCore</PackageId>
        <RootNamespace>NanoProfiler</RootNamespace>
        <LangVersion>11</LangVersion>
        <Nullable>annotations</Nullable>
        <DefaultItemExcludes>artifacts~\**;**\*.meta;**\*.asmdef;</DefaultItemExcludes>
        <OutputPath>$(MSBuildThisFileDirectory)artifacts~\bin\$(Configuration)\</OutputPath>
        <IntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts~\obj\$(Configuration)</IntermediateOutputPath>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>true</IsPackable>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    </PropertyGroup>

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk"/>

    <ItemGroup>
        <Compile Include="..\..\src\Runtime\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.30.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    </ItemGroup>

</Project>
