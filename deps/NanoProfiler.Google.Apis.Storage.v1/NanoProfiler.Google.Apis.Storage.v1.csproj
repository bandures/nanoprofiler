<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Storage.v1" Version="1.73.0.3974" />
    <PackageReference Include="Google.Cloud.Storage.V1" Version="4.10.0" />
    <PackageReference Include="ILRepack" Version="2.0.18" PrivateAssets="All" GeneratePathProperty="true" />
    
    <PackageReference Include="Semver" Version="2.3.0" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="6.0.1" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <InputAssemblies Include="$(TargetDir)$(AssemblyName).dll" />

      <InputAssemblies Include="$(TargetDir)Google.Cloud.Storage.V1.dll" />
      <InputAssemblies Include="$(TargetDir)Google.Apis.Storage.v1.dll" />
      <InputAssemblies Include="$(TargetDir)Google.Apis.dll" />
      <InputAssemblies Include="$(TargetDir)Google.Apis.Core.dll" />
      <InputAssemblies Include="$(TargetDir)Google.Apis.Auth.dll" />
      <InputAssemblies Include="$(TargetDir)Google.Api.Gax.dll" />
      <InputAssemblies Include="$(TargetDir)Google.Api.Gax.Rest.dll" />

      <InputAssemblies Include="$(TargetDir)System.Memory.dll" />
      <InputAssemblies Include="$(TargetDir)System.Buffers.dll" />
      <InputAssemblies Include="$(TargetDir)System.Numerics.Vectors.dll" />
      <InputAssemblies Include="$(TargetDir)System.Management.dll" />
      <InputAssemblies Include="$(TargetDir)System.CodeDom.dll" />
      <InputAssemblies Include="$(TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <InputAssemblies Include="$(TargetDir)System.Diagnostics.DiagnosticSource.dll" />
      
      <InputAssemblies Include="$(TargetDir)Microsoft.Bcl.AsyncInterfaces.dll" />
      <InputAssemblies Include="$(TargetDir)Newtonsoft.Json.dll" />

      <InputAssemblies Include="$(TargetDir)Semver.dll" />
    </ItemGroup>

    <MakeDir Directories="$(MSBuildProjectDirectory)\..\..\src\Editor\" />

    <Exec Command="$(PkgILRepack)\tools\ILRepack.exe /parallel /internalize /lib:&quot;$(TargetDir).&quot; /out:&quot;$(MSBuildProjectDirectory)\..\..\src\Editor\$(AssemblyName).dll&quot; @(InputAssemblies->'&quot;%(Identity)&quot;', ' ')" />

    <Message Text="SUCCESS: Merged DLL created at ..\..\src\Editor\$(AssemblyName).dll" Importance="high" />
  </Target>
</Project>